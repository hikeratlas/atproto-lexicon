{
  "lexicon": 1,
  "id": "com.hikeratlas.temp.actor.profile",
  "description": "An account's Hiker Atlas (https://www.hikeratlas.com) settings. Written when the account first signs in to Hiker Atlas, so it also marks the account as a Hiker Atlas user. In beta: may change.",
  "defs": {
    "main": {
      "type": "record",
      "key": "literal:self",
      "record": {
        "type": "object",
        "required": [
          "createdAt"
        ],
        "properties": {
          "createdAt": {
            "type": "string",
            "format": "datetime"
          },
          "units": {
            "type": "ref",
            "ref": "#units"
          },
          "license": {
            "type": "string",
            "knownValues": [
              "CC0-1.0",
              "CC-BY-4.0",
              "hikeratlas-only"
            ],
            "description": "The licence for this account's new reviews and tracks, each of which records its own in its license field: CC0-1.0, CC-BY-4.0 or hikeratlas-only."
          }
        }
      }
    },
    "units": {
      "type": "object",
      "properties": {
        "distance": {
          "type": "string",
          "knownValues": [
            "km",
            "mi"
          ]
        },
        "elevation": {
          "type": "string",
          "knownValues": [
            "m",
            "ft"
          ]
        }
      }
    }
  }
}
