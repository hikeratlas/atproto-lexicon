{
  "lexicon": 1,
  "id": "com.hikeratlas.temp.getRouteReviews",
  "defs": {
    "main": {
      "type": "query",
      "description": "Reviews of a route, newest first. Served by Hiker Atlas's indexer (https://github.com/hikeratlas/atproto-indexer). In beta: may change.",
      "parameters": {
        "type": "params",
        "required": [
          "key"
        ],
        "properties": {
          "key": {
            "type": "string",
            "maxLength": 128,
            "description": "A route key (com.hikeratlas.temp.defs#routeKey)."
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 50,
            "default": 20
          },
          "cursor": {
            "type": "string"
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "reviews"
          ],
          "properties": {
            "reviews": {
              "type": "array",
              "items": {
                "type": "ref",
                "ref": "com.hikeratlas.temp.defs#reviewView"
              }
            },
            "cursor": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
